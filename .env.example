# Copy to .env (git-ignored) for local use. In Colab use Secrets (key icon), never paste tokens into notebooks or chat.
# Read-only, repository-scoped GitHub token used by the cloud notebook to clone this PRIVATE repo:
GITHUB_TOKEN=
# Only if you use Kaggle Notebooks / the Kaggle API (https://www.kaggle.com/settings -> API):
KAGGLE_USERNAME=
KAGGLE_KEY=
# Persistent run directory in the cloud (Colab: a folder on mounted Google Drive)
BRAINTUMOR_RUNS_DIR=/content/drive/MyDrive/brain-tumor-3d-print/runs
